# =============================================================================
# TYS Global Logistics — every key the app reads (from migration/08-dependencies.md).
# Copy to .env for local dev. Production values are set on Hostinger.
# =============================================================================

APP_NAME="TYS Global Logistics"
# Public site URL — used for absolute URL generation (email tracking pixel,
# canonical/OG URLs, sitemap.xml, JSON-LD). Production is the www subdomain.
# Dev: http://localhost:3000
APP_URL="https://www.tysgloballogistics.com"
# All timestamps are UTC (Laravel parity) — run Node with TZ=UTC.
TZ=UTC

# --- Database ----------------------------------------------------------------
# Prisma OWNS this schema (`prisma migrate`) — point at a FRESH database, never
# Laravel's live import_export DB (kept untouched as rollback). Keep
# connection_limit SMALL — managed MySQL caps concurrent connections (§4).
# Dev (Docker):  mysql://root:tys_local@127.0.0.1:33061/tys_next?connection_limit=5
DATABASE_URL="mysql://user:password@127.0.0.1:3306/tys_next?connection_limit=5"

# --- Auth (Better Auth) ------------------------------------------------------
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# The ADMIN origin — session cookie is scoped to this host only.
# Dev: http://admin.localhost:3000
BETTER_AUTH_URL="https://admin.tysgloballogistics.com"
# Hostname src/proxy.ts treats as the admin host (must match BETTER_AUTH_URL).
# Dev: admin.localhost
ADMIN_HOST="admin.tysgloballogistics.com"
# Cost for bcrypt hashes written by scripts (matches Laravel's BCRYPT_ROUNDS).
BCRYPT_ROUNDS=12
# Public rate limiting keys on the client IP taken from X-Forwarded-For, counted
# from the RIGHT (the hops our own infra appends). ⚠️ CUTOVER: log the raw XFF
# from a real external request on the target host, read the proxy chain, and set
# this so the limiter lands on the real client hop. Wrong value = the store
# limiter is bypassable. Default 1 = a single trusted proxy in front of the app.
TRUSTED_PROXY_HOPS=1

# --- PII encryption (vendors.ssn_number, R-PII) -------------------------------
# 64 hex chars (32 bytes): openssl rand -hex 32. Owner-managed; rotating it
# requires re-encrypting stored SSNs (see src/lib/pii.ts).
SSN_ENCRYPTION_KEY=""

# --- FedEx. Every API is its own FedEx project with its own client
# id/secret AND its own sandbox-vs-production cutover — a Rate-only project
# isn't entitled to call Track (FedEx returns FORBIDDEN.ERROR), and each
# project's production keys are separate from its sandbox keys. Production
# base URL is https://apis.fedex.com (sandbox: https://apis-sandbox.fedex.com).
FEDEX_ENABLED=false
# Original/fallback pair — used only if FEDEX_RATE_*/FEDEX_TRACK_* below are unset.
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""
FEDEX_RATE_CLIENT_ID=""
FEDEX_RATE_CLIENT_SECRET=""
FEDEX_RATE_BASE_URL="https://apis-sandbox.fedex.com"
FEDEX_TRACK_CLIENT_ID=""
FEDEX_TRACK_CLIENT_SECRET=""
FEDEX_TRACK_BASE_URL="https://apis-sandbox.fedex.com"
FEDEX_ACCOUNT_NUMBER=""
FEDEX_BASE_URL="https://apis-sandbox.fedex.com"
FEDEX_CARRIER_CODE="FDXG"
FEDEX_LOCALE="en_US"
FEDEX_PICKUP_TYPE="DROPOFF_AT_FEDEX_LOCATION"
FEDEX_MAX_PARCEL_WEIGHT_LB=150
FEDEX_POSTAL_VALIDATION_ENABLED=false

# --- Geocoding (OpenStreetMap Nominatim — free, no API key) -------------------
# Vendor addresses geocode inline on save (fail-open — a geocoding failure
# never blocks the save). Leave unset for the public Nominatim endpoint;
# override for tests or a self-hosted/paid geocoder.
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# --- Mail (Nodemailer, inline send — no queue worker) ------------------------
# ⚠️ $ in values: the env loader (@next/env — used by the app AND the tsx
# scripts via scripts/env.ts) expands $VAR/${VAR}, even inside quotes. Escape
# any literal dollar as \$ (e.g. SMTP_PASSWORD="pa\$\$word"). Exception:
# DATABASE_URL is also read by the Prisma CLI, which does NOT expand or
# unescape — avoid $ there entirely.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
MAIL_FROM_ADDRESS="noreply@tysgloballogistics.com"
# Hard-coded on purpose: plain dotenv (tsx scripts) does NOT expand ${...},
# only Next's env loader does — an interpolated value renders literally in
# script-sent mail. Keep this a plain string.
MAIL_FROM_NAME="TYS Global Logistics"
# Sender for anything that invites a reply (quote resend/options) — the
# automatic quote-submission confirmation and admin notifications still send
# from MAIL_FROM_ADDRESS above.
MAIL_SALES_ADDRESS="sales@tysgloballogistics.com"
# Shown as the display name + email sign-off on anything sent from sales@ —
# the actual person behind that inbox, not a generic company name.
MAIL_SALES_REP_NAME="Krutik"
# sales@ is a real, separate mailbox, not an alias — most SMTP relays reject
# a From: sales@ unless the session actually authenticates as sales@ itself.
# Unset = falls back to the default (MAIL_FROM_ADDRESS) transporter, meaning
# sales@-attributed sends will likely get rejected by a strict relay.
SALES_SMTP_USERNAME="sales@tysgloballogistics.com"
SALES_SMTP_PASSWORD=""
# Comma-separated list — parsed with trim + filter (08-dependencies).
ADMIN_NOTIFICATION_EMAILS=""

# --- Google Ads conversion tracking (/thank-you page) -------------------------
# From Google Ads > Tools & Settings > Conversions > (the quote-lead action) >
# "Tag setup" > "Install the tag yourself". Public by design — Ads IDs ship in
# page source, not secret. Leave both unset to skip loading gtag.js entirely.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=""

# --- Analytics (GA4, GTM, Microsoft Clarity) — public pages only, each
# independently no-ops if unset. Public by design, not secret. ----------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_CLARITY_ID=""
# Search Console domain verification meta tag.
GOOGLE_SITE_VERIFICATION=""
